digraph snakemake_dag {
    graph[bgcolor=white, margin=0];
    node[shape=box, style=rounded, fontname=sans,                 fontsize=10, penwidth=2];
    edge[penwidth=2, color=grey];
	0[label = "all", color = "0.00 0.6 0.85", style="rounded,dashed"];
	1[label = "combine", color = "0.27 0.6 0.85", style="rounded,dashed"];
	2[label = "clean_samples", color = "0.13 0.6 0.85", style="rounded,dashed"];
	3[label = "query_patients", color = "0.40 0.6 0.85", style="rounded,dashed"];
	4[label = "report", color = "0.53 0.6 0.85", style="rounded,dashed"];
	1 -> 0
	4 -> 0
	2 -> 1
	3 -> 1
	1 -> 4
}            
